<resources>
    <!-- Shown while the app starts (androidx.core.splashscreen; the system splash on 12+). -->
    <style name="Theme.Waylus.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/waylus_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Waylus</item>
    </style>

    <!-- After the splash: black window behind the video, edge to edge. Everything else is
         drawn by Compose (ui/Theme.kt). -->
    <style name="Theme.Waylus" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
